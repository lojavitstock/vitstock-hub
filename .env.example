# ===================================================
# VITSTOCK HUB - Variáveis de Ambiente (.env.local)
# ===================================================

# Backend seguro hospedado no Railway
VITE_API_URL=https://sua-api.up.railway.app

# Variáveis exclusivas do backend (Railway / desenvolvimento local)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/vitstock_hub
EVOLUTION_API_URL=https://sua-evolution-api.up.railway.app
EVOLUTION_API_KEY=substitua-por-uma-chave-forte
EVOLUTION_INSTANCE_NAME=vitstock_atendimento
SESSION_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-43-caracteres
WEBHOOK_SECRET=gere-outro-segredo-aleatorio-com-pelo-menos-43-caracteres
FRONTEND_URL=http://localhost:5173
# Origens adicionais confiáveis, separadas por vírgula (sem wildcard)
ALLOWED_FRONTEND_ORIGINS=

# Usadas apenas uma vez para criar o primeiro administrador
INITIAL_COMPANY_NAME=Vitstock
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=admin@exemplo.com
INITIAL_ADMIN_PASSWORD=troque-por-uma-senha-temporaria-forte

# Modo de Demonstração (Mudar para false quando quiser usar a Evolution API real)
VITE_USE_MOCK_DATA=true

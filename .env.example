# ===================================================
# VITSTOCK HUB - Variáveis de Ambiente (.env.local)
# ===================================================

# Evolution API (Integração WhatsApp)
# Se rodar via Docker na sua máquina: http://localhost:8080
# Se rodar na sua VPS: https://sua-api.seudominio.com
VITE_EVOLUTION_API_URL=http://localhost:8080
VITE_EVOLUTION_API_KEY=vitstock_global_key_2026
VITE_EVOLUTION_INSTANCE_NAME=vitstock_atendimento

# Supabase (Banco de Dados, Autenticação e Realtime)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_do_supabase_aqui

# Modo de Demonstração (Mudar para false quando quiser usar a Evolution API real)
VITE_USE_MOCK_DATA=true
